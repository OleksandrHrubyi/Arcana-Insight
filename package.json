{
  "name": "arcana",
  "version": "0.0.1",
  "description": "tarot horoscope",
  "productName": "Arcana Insight",
  "author": "Oleksandr H BO:FE <oleksandr.h@lineir.me>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "find tests -name '*.test.js' -print0 | xargs -0 node --test",
    "test:coverage": "find tests -name '*.test.js' -print0 | xargs -0 node --test --experimental-test-coverage",
    "test:functions": "DENO_NO_PACKAGE_JSON=1 deno test --allow-env --allow-net supabase/functions/tests/",
    "ai:scan:code": "node ai-ops/checks/code-scan.js",
    "ai:scan:launch": "node ai-ops/checks/launch-readiness.js",
    "ai:scan:test": "node ai-ops/checks/test-status.js",
    "ai:scan:build": "node ai-ops/checks/build-status.js",
    "ai:scan:all": "node ai-ops/run-all.js",
    "ai:brief": "node ai-ops/briefing/buildBriefingInput.js",
    "ai:dashboard": "node ai-ops/dashboard/server.js",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "qa:home-shot": "playwright test tests/visual/home.spec.js",
    "qa:home-shot:update": "playwright test tests/visual/home.spec.js --update-snapshots",
    "qa:home-shot:report": "playwright show-report",
    "iosbuild": "npx quasar build",
    "ioscopy": "npx cap copy ios",
    "iosopen": "open ios/App/App.xcworkspace",
    "iosprep": "npm run iosbuild && npm run ioscopy && npm run iosopen",
    "iossync": "npx cap sync ios && npm run iosopen",
    "ios:assets": "capacitor-assets generate --ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "party": "npm run iosbuild && npm run iossync",
    "party:ios": "bash scripts/release-ios.sh",
    "release:ios": "bash scripts/release-ios.sh",
    "release:ios:quick": "bash scripts/release-ios.sh --no-lint"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^5.0.0",
    "@capacitor-firebase/analytics": "^5.4.1",
    "@capacitor-firebase/crashlytics": "^5.4.1",
    "@capacitor/app": "^5.0.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/device": "^5.0.8",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/geolocation": "^5.0.8",
    "@capacitor/haptics": "^5.0.8",
    "@capacitor/ios": "^5.7.8",
    "@capacitor/local-notifications": "^5.0.8",
    "@capacitor/preferences": "^5.0.8",
    "@capacitor/push-notifications": "^5.1.2",
    "@capacitor/share": "^5.0.8",
    "@capacitor/status-bar": "^5.0.8",
    "@fontsource/nunito": "^5.2.7",
    "@quasar/extras": "^1.16.4",
    "@revenuecat/purchases-capacitor": "^7.7.1",
    "@supabase/supabase-js": "^2.89.0",
    "astronomy-engine": "^2.1.19",
    "dotenv": "^17.2.3",
    "firebase": "^10.14.1",
    "gsap": "^3.13.0",
    "jsonwebtoken": "^9.0.2",
    "quasar": "^2.16.0",
    "satellite.js": "^5.0.0",
    "vue": "3.5.20",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.59.1",
    "@quasar/app-vite": "^2.1.0",
    "@quasar/cli": "^5.0.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "sharp": "^0.35.2",
    "vite-plugin-checker": "^0.10.3",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
